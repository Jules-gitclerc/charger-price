# Prix-Bornes — environment variables
# Copy to .env.local and fill values. .env* is gitignored except this template.
# See docs/03-implementation-plan.md §1 (Day-1 checklist) for provisioning.

# --- Supabase (project: prix-bornes / atnqcnksychurygcbnxi / eu-west-3) ---
# Public values, safe to expose to the browser:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only secrets — NEVER expose to the client:
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string for Drizzle / migrations / IRVE COPY pipeline.
# Use the "Connection pooling DISABLED" URI for COPY operations (T06a).
SUPABASE_DB_URL=

# --- Geocoding (api-adresse.data.gouv.fr) — no API key needed ---
# Polite UA per BAN documentation (≤10 req/s, batches of 100 in T07).
BAN_USER_AGENT=Prix-Bornes/1.0 (+https://github.com/Jules-gitclerc/charger-price)

# --- Internal viewer basic auth (T15, W5) ---
# Generate password with: openssl rand -base64 24
INTERNAL_VIEWER_USER=
INTERNAL_VIEWER_PASSWORD=
